{
  "name": "open-health-sync-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "tsx scripts/sync-docs.mts && tsx scripts/generate-api.mts",
    "predev": "npm run sync",
    "dev": "next dev",
    "prebuild": "npm run sync",
    "build": "next build",
    "start": "serve out",
    "types:check": "npm run sync && fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "^12.4.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "lucide-react": "^1.50.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "github-slugger": "^2.0.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
