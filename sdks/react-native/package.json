{
  "name": "open-health-sync-react-native",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the Open Health Sync REST API (React Native, Expo, Node 18+, browsers), and a native module that syncs HealthKit and Health Connect.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/soma-intelligence/open-health-sync.git",
    "directory": "sdks/react-native"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "react-native": "./src/health/index.ts",
      "import": "./dist/health/index.js",
      "default": "./dist/health/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "android",
    "ios",
    "plugin",
    "app.plugin.js",
    "*.podspec",
    "README.md",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/local-maven",
    "!ios/build"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "example": "tsc -p tsconfig.test.json && node dist-test/example/quickstart.js"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "peerDependencies": {
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.8.3"
  },
  "codegenConfig": {
    "name": "OpenHealthSyncSpec",
    "type": "modules",
    "jsSrcsDir": "src/health",
    "android": {
      "javaPackageName": "org.openhealthsync.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "OpenHealthSync": "OpenHealthSyncModule"
      }
    }
  }
}
