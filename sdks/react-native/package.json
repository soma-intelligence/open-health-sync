{
  "name": "open-health-sync-react-native",
  "version": "0.1.0",
  "description": "TypeScript client for Open Health Sync, the open source health data aggregator: Apple Health, Health Connect, Oura, WHOOP, Withings and more through one API, in React Native, Expo, Node 18+ and browsers.",
  "keywords": [
    "health-data",
    "wearables",
    "apple-health",
    "healthkit",
    "health-connect",
    "fhir",
    "react-native",
    "expo",
    "quantified-self",
    "open-health-sync",
    "terra-alternative"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/soma-intelligence/open-health-sync/blob/main/docs/sdks/react-native.md",
  "bugs": {
    "url": "https://github.com/soma-intelligence/open-health-sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soma-intelligence/open-health-sync.git",
    "directory": "sdks/react-native"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "example": "tsc -p tsconfig.test.json && node dist-test/example/quickstart.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
