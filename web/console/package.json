{
  "name": "ohs-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "schema": "openapi-typescript ../../api/openapi.yaml -o src/api/schema.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
