# Copy to .env.local (git ignores it) and fill in. Read on the server only: none of these
# names starts with NEXT_PUBLIC_, so Next.js never sends them to the browser.

# Base URL of your Open Health Sync instance.
OHS_URL=http://localhost:8080

# A tenant API key (ohs_sk_...). `ohs admin tenant create --name web-example` prints one, and so
# does the admin console of your instance. It can read every user of the tenant: keep it here.
OHS_API_KEY=

# The whsec_... secret of this app's webhook endpoint, shown once when it is registered (from
# the webhooks page of this app, or with POST /v1/webhooks). Optional: without it the app keeps
# a secret registered from its own page in memory until it restarts.
OHS_WEBHOOK_SECRET=

# Where this app is reached: the hosted connection page sends people back here, and the
# webhook endpoint is APP_URL/api/webhooks. Set it to your tunnel's https address to receive
# webhooks from an instance that is not on this machine.
APP_URL=http://localhost:3000
