    "typecheck": "tsc --noEmit",
    "bundle-check": "expo export --platform android --output-dir dist-check"
  },
  "dependencies": {
    "expo": "54.0.38",
    "expo-asset": "12.0.14",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "fflate": "0.8.3",
    "open-health-sync-react-native": "file:../../sdks/react-native",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@types/react": "19.1.17",
    "babel-preset-expo": "54.0.12",
    "typescript": "5.8.3"
  }
}
