# Copy to .env and edit. Variables left empty use the default shown in the comment.

# Postgres connection URL (docker compose sets it for you).
OHS_DATABASE_URL=postgres://ohs:ohs@localhost:5432/ohs?sslmode=disable
# 32 random bytes, base64. Run `ohs doctor` once to get a fresh one. Keep it safe: losing it loses stored OAuth tokens.
OHS_ENCRYPTION_KEY=
# Public base URL of this server, used for OAuth callbacks (default http://localhost:8080).
OHS_PUBLIC_URL=http://localhost:8080
# Where raw files go: file:///abs/path or s3://bucket?endpoint=&region=&path_style=true (default file:///var/lib/ohs/raw).
OHS_RAW_STORE=file:///var/lib/ohs/raw
# Roles this process runs, comma separated: api, collect, etl (default api,collect,etl).
OHS_ROLES=api,collect,etl
# Name of a tenant created at first start so you can issue an API key right away (empty = none).
OHS_BOOTSTRAP_TENANT=
# Listen address (default :8080).
OHS_LISTEN=:8080
# Log level: debug, info, warn or error (default info).
OHS_LOG_LEVEL=info
# Expose Prometheus metrics on /metrics: true or false (default true).
OHS_METRICS=true
# Serve the read-only admin console on /console: true or false (default false). See docs/console.md.
OHS_CONSOLE=false
# Bearer token Prometheus sends to scrape /metrics (16+ characters, openssl rand -hex 32). Without it, or OHS_METRICS_LISTEN, /metrics refuses every scrape.
# OHS_METRICS_TOKEN=
# Serve /metrics on a private address of its own instead of the API listener, for example 127.0.0.1:9464.
# OHS_METRICS_LISTEN=
# OpenTelemetry traces (optional, off by default; see docs/observability.md). Setting an OTLP
# endpoint turns them on; the other standard OTEL_ variables are honoured too.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=ohs
# Delete raw files AND normalized data (samples, sleep, workouts, daily summaries) older than this many days, 0 keeps everything forever (default 0).
OHS_RETENTION_DAYS=0
# Store nothing from a source until the user's consent for it is recorded (default false: no consent recorded stores everything).
# OHS_CONSENT_REQUIRED=false
# Delete audit events older than this many days, once a day; 0 keeps every event (default 365).
OHS_AUDIT_RETENTION_DAYS=365
# Device uploads (Apple Health) one api process handles at once; more answer 503 with Retry-After (default 8).
OHS_INGEST_CONCURRENCY=8
# Let outgoing webhooks use plain http and reach private or loopback addresses: true or false (default false).
# Keep it false on a server that faces the internet: it turns off the SSRF guard.
# OHS_WEBHOOK_ALLOW_PRIVATE=false
# Image tag docker compose runs (optional, default 0.1.0; pass --env-file .env to compose to use it).
# OHS_VERSION=0.1.0
# Compose only, not read by ohs: host port the API is published on (optional, default 8080;
# pass --env-file .env to compose to use it). Set OHS_PUBLIC_URL to the same port.
# OHS_HTTP_PORT=8080
# Compose only: host address the API port listens on (optional, default 127.0.0.1, this machine only).
# 0.0.0.0 publishes plain http to the network; prefer a reverse proxy with TLS.
# OHS_HTTP_BIND=127.0.0.1
# Postgres password for the bundled compose database (optional, default ohs; pass --env-file .env to compose to use it).
POSTGRES_PASSWORD=ohs
# Demo S3 credentials, only used with deploy/docker-compose.s3.yml (pass --env-file .env to compose).
# S3_ACCESS_KEY=ohsaccess
# S3_SECRET_KEY=change-me
# Provider keys, one pair per enabled provider, for example Withings and Oura:
# OHS_WITHINGS_CLIENT_ID=
# OHS_WITHINGS_CLIENT_SECRET=
# OHS_OURA_CLIENT_ID=
# OHS_OURA_CLIENT_SECRET=
# Optional: turns Oura webhooks on (see docs/connectors/oura.md).
# OHS_OURA_VERIFICATION_TOKEN=
# Fitbit through the Google Health API (see docs/connectors/fitbit.md). Webhooks are optional.
# OHS_FITBIT_CLIENT_ID=
# OHS_FITBIT_CLIENT_SECRET=
# OHS_FITBIT_WEBHOOK_SECRET=
# Suunto Cloud API (partner program; see docs/connectors/suunto.md). The notification secret is optional.
# OHS_SUUNTO_CLIENT_ID=
# OHS_SUUNTO_CLIENT_SECRET=
# OHS_SUUNTO_SUBSCRIPTION_KEY=
# OHS_SUUNTO_NOTIFICATION_SECRET=
# Ultrahuman Partnership API (see docs/connectors/ultrahuman.md).
# OHS_ULTRAHUMAN_CLIENT_ID=
# OHS_ULTRAHUMAN_CLIENT_SECRET=
# intervals.icu (see docs/connectors/intervals-icu.md). The webhook secret is optional.
# OHS_INTERVALS_ICU_CLIENT_ID=
# OHS_INTERVALS_ICU_CLIENT_SECRET=
# OHS_INTERVALS_ICU_WEBHOOK_SECRET=
# WHOOP (see docs/connectors/whoop.md).
# OHS_WHOOP_CLIENT_ID=
# OHS_WHOOP_CLIENT_SECRET=
# Polar AccessLink (see docs/connectors/polar.md). The webhook secret is optional.
# OHS_POLAR_CLIENT_ID=
# OHS_POLAR_CLIENT_SECRET=
# OHS_POLAR_WEBHOOK_SECRET=
# Strava (see docs/connectors/strava.md). The verify token and subscription id are optional.
# OHS_STRAVA_CLIENT_ID=
# OHS_STRAVA_CLIENT_SECRET=
# OHS_STRAVA_VERIFY_TOKEN=
# OHS_STRAVA_SUBSCRIPTION_ID=
# Dexcom API v3 (see docs/connectors/dexcom.md). Region: us (default), eu, jp or sandbox.
# OHS_DEXCOM_CLIENT_ID=
# OHS_DEXCOM_CLIENT_SECRET=
# OHS_DEXCOM_REGION=
# OMRON (partner API; see docs/connectors/omron.md). Environment: production (default) or staging.
# OHS_OMRON_CLIENT_ID=
# OHS_OMRON_CLIENT_SECRET=
# OHS_OMRON_ENVIRONMENT=
# Fitbit webhook signature check (see docs/connectors/fitbit.md).
# OHS_FITBIT_WEBHOOK_SIGNATURE=

# Client side only, read by `ohs mcp` on your machine, not by the server.
# Base URL of the instance (default OHS_PUBLIC_URL) and the key it sends.
# OHS_MCP_URL=http://localhost:8080
# OHS_MCP_KEY=
